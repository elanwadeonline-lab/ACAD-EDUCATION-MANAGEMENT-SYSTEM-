{
  "name": "exampool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun --env-file=.env server.ts\" \"cd frontend && bun run dev\"",
    "postinstall": "cd frontend && bun install",
    "build": "cd frontend && bun run build",
    "start": "bun --env-file=.env server.ts",
    "setup": "cd frontend && bun install",
    "hosts:setup": "bun run scripts/setup-hosts.ts",
    "mobile:guardian": "cd apps/mobile-guardian && bun serve-preview.ts",
    "mobile:guardian:dev": "cd apps/mobile-guardian && npx expo start"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/ioredis": "^5.0.0",
    "concurrently": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "dns2": "^3.0.0",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
