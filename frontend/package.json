{
  "name": "exampool-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"['dist','.next'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}});\"",
    "predev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node -e \"['dist','.next'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}});\"",
    "build": "next build && node ../scripts/publish-static.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/node-forge": "^1.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.35.0",
    "mammoth": "^1.12.0",
    "next": "15.1.0",
    "node-forge": "^1.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.2"
  }
}
