{
  "name": "exampool-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"['dist','.next'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}});\"",
    "predev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node -e \"['dist','.next'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}});\"",
    "build": "next build"
  },
  "dependencies": {
    "@types/node-forge": "^1.3.14",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.35.0",
    "mammoth": "^1.12.0",
    "next": "15.1.0",
    "node-forge": "^1.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.2"
  }
}
